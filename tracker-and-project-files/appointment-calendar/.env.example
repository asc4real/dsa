# LOCAL DEVELOPMENT ONLY. Copy to .env and replace values; never commit .env.
DB_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_KEYCLOAK_ADMIN_PASSWORD
OIDC_ISSUER_URI=http://localhost:8081/realms/appointments
OIDC_AUDIENCE=appointment-calendar-api
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025

CURSOR_SIGNING_SECRET=REPLACE_WITH_RANDOM_32_CHAR_OR_LONGER_SECRET

APP_ALLOWED_ORIGINS=http://localhost:3000
